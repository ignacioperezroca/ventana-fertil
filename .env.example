# Public application URL. Use http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase publishable values may be exposed to the browser. RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Stripe server-only secrets and allowlisted recurring prices.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_MONTHLY=price_replace_me
STRIPE_PRICE_ID_YEARLY=
